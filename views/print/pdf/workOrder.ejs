<!doctype html>
<html lang="en">
  <head>
    <title><%= headTitle %></title>
    <style>
      <%- include('style.css'); %>
    </style>
  </head>
  <body>
    <%- include('_workOrder-header.ejs'); %>
    
    <% if (workOrder.workOrderBurialSites.length > 0) { %>
    <h2 class="mb-0">Burial Sites</h2>

    <table class="data-table">
      <thead>
        <tr>
          <th>Burial Site</th>
          <th>Cemetery</th>
          <th>Burial Site Type</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% for (const burialSite of workOrder.workOrderBurialSites) { %>
        <tr>
          <td><%= burialSite.burialSiteName %></td>
          <td><%= burialSite.cemeteryName %></td>
          <td><%= burialSite.burialSiteType %></td>
          <td><%= burialSite.burialSiteStatus %></td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>

    <% if (workOrder.workOrderContracts.length > 0) { %>
    <h2 class="mb-0">Contracts</h2>

    <table class="data-table">
      <thead>
        <tr>
          <th>Contract Type</th>
          <th>Burial Site</th>
          <th>Service Details</th>
          <% if (configFunctions.getConfigProperty('settings.contracts.contractEndDateIsAvailable')) { %>
          <th>End Date</th>
          <% } %>
          <th>Recipient</th>
        </tr>
      </thead>
      <tbody>
        <% for (const contract of workOrder.workOrderContracts) { %>
        <tr>
          <td><%= contract.contractType %></td>
          <td>
            <%= contract.burialSiteName %>
            <% if (contract.cemeteryName) { %>
            <br />
            <span class="is-size-7"><%= contract.cemeteryName %></span>
            <% } %>
          </td>
          <td>
            <% if (contract.funeralDateString || contract.funeralHomeName || (contract.directionOfArrival ?? '') !== '' || contract.committalType) { %>
            <% if (contract.funeralDateString) { %>
            <strong>Service:</strong> <%= contract.funeralDateString %>
            <% if (contract.funeralTime !== null && contract.funeralTime !== 0) { %>
            <%= contract.funeralTimePeriodString %>
            <% } %><br />
            <% } %>
            <% if (contract.funeralHomeName) { %>
            <strong>Funeral Home:</strong> <%= contract.funeralHomeName %><br />
            <% } %>
            <% if ((contract.directionOfArrival ?? '') !== '') { %>
            <strong>Direction of Arrival:</strong> <%= contract.directionOfArrivalDescription %>
            <span class="tag"><%= contract.directionOfArrival %></span><br />
            <% } %>
            <% if (contract.committalType) { %>
            <strong>Committal Type:</strong> <%= contract.committalType %>
            <% } %>
            <% } else { %>
            -
            <% } %>
          </td>
          <% if (configFunctions.getConfigProperty('settings.contracts.contractEndDateIsAvailable')) { %>
          <td><%= contract.contractEndDateString %></td>
          <% } %>
          <td>
            <% if (contract.contractInterments && contract.contractInterments.length > 0) { %>
            <% for (const interment of contract.contractInterments) { %>
            <%= interment.deceasedName %>
            <% if (interment.intermentContainerType || interment.intermentDepth) { %>
            <br />
            <span class="is-size-7">
              <% if (interment.intermentContainerType) { %>
              <%= interment.intermentContainerType %>
              <% } %>
              <% if (interment.intermentContainerType && interment.intermentDepth) { %>
              ·
              <% } %>
              <% if (interment.intermentDepth) { %>
              <%= interment.intermentDepth %>
              <% } %>
            </span>
            <% } %><br />
            <% } %>
            <% } else if (contract.purchaserName) { %>
            <%= contract.purchaserName %>
            <% } else { %>
            -
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>

    <% if (workOrder.workOrderMilestones.length > 0) { %>
    <h2 class="mb-0">Milestones</h2>

    <table class="data-table">
      <thead>
        <tr>
          <th class="is-width-1"></th>
          <th>Milestone Description</th>
          <th>Due Date</th>
        </tr>
      </thead>
      <tbody>
        <% for (const milestone of workOrder.workOrderMilestones) { %>
        <tr>
          <td class="is-width-1">
            <% if (milestone.workOrderMilestoneCompletionDate) { %>
            <span class="checkbox is-checked"></span>
            <% } else { %>
            <span class="checkbox"></span>
            <% } %>
          </td>
          <td>
            <% if (milestone.workOrderMilestoneTypeId) { %>
            <strong><%= milestone.workOrderMilestoneType %></strong><br />
            <% } %>
            <%= milestone.workOrderMilestoneDescription %>
          </td>
          <td>
            <% if (milestone.workOrderMilestoneDate === 0) { %>
            (No Set Date)
            <% } else { %>
            <%= milestone.workOrderMilestoneDateString %>
            <% } %>
            <% if (milestone.workOrderMilestoneTime) { %>
            <%= milestone.workOrderMilestoneTimePeriodString %>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <% } %>

    <h2 class="mb-0">Notes</h2>

    <p style="position: absolute; bottom: 5px; left: 20px;">
      <%
      const barcodeData = barcodeFunctions.generateBarcodeSvg(workOrder.workOrderNumber, {
        format: 'CODE128',
        width: 2,
        height: 50,
        margin: 0,
        displayValue: false
      })
      %>
      <%- barcodeData %>
    </p>

    <p class="has-text-right is-italic is-8pt" style="position: absolute; bottom: 15px; right: 20px;">
      <%
      const recordCreateDate = new Date(workOrder.recordCreate_timeMillis);
      const currentDate = new Date();
      %>
      Work order created <%= dateTimeFunctions.dateToString(recordCreateDate) %> at <%= dateTimeFunctions.dateToTimePeriodString(recordCreateDate) %>.
      Printed <%= dateTimeFunctions.dateToString(currentDate) %> at <%= dateTimeFunctions.dateToTimePeriodString(currentDate) %>.<br />
      workOrderId = <%= workOrder.workOrderId %>
    </p>
  </body>
</html>