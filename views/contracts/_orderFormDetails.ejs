<% const orderFormData = orderForm.orderFormData; %>
<% const mismatchSet = new Set((mismatches ?? []).map((mismatch) => mismatch.label)); %>
<%
const selectedServiceTypeIds = Object.entries(orderFormData)
  .filter(([key, value]) => key.startsWith('serviceTypeId-') && (value === 'true' || value === true))
  .map(([key]) => Number(key.replace('serviceTypeId-', '')))
  .filter((serviceTypeId) => !Number.isNaN(serviceTypeId));

const selectedServiceTypeNames = selectedServiceTypeIds
  .map((serviceTypeId) => {
    const serviceTypeLabel = orderFormData[`serviceTypeIdText-${serviceTypeId}`];
    return typeof serviceTypeLabel === 'string' ? serviceTypeLabel : '';
  })
  .filter((serviceTypeName) => serviceTypeName !== '');
%>

<div class="columns is-mobile is-vcentered">
  <div class="column">
    <h1 class="title is-1">
      <%= t('contracts.orderFormTitle', { id: orderForm.orderFormId }) %>
    </h1>
  </div>
  <div class="column is-narrow has-text-right">
    <span class="tag <%= orderForm.isOrderFormProcessed === 1 ? 'is-success' : 'is-warning' %>">
      <%= t(orderForm.isOrderFormProcessed === 1 ? 'contracts.processed' : 'contracts.notProcessed') %>
    </span>
  </div>
</div>

<% if (mismatches.length > 0) { %>
<div class="notification is-warning is-light">
  <p class="has-text-weight-bold"><%= t('contracts.mismatchedValues') %></p>
  <ul>
    <% for (const mismatch of mismatches) { %>
    <li>
      <strong><%= mismatch.label %>:</strong>
      <%= mismatch.actualText || mismatch.actualId || t('contracts.noValue') %>
    </li>
    <% } %>
  </ul>
</div>
<% } %>

<div class="panel">
  <div class="panel-block is-block">
    <div class="columns">
      <div class="column">
        <p>
          <strong><%= t('contracts.submittedBy') %></strong><br />
          <%= orderFormData.submitterName %><br />
          <%= orderFormData.submitterEmail || t('contracts.noValue') %>
        </p>
      </div>
      <div class="column">
        <p class="mb-4">
          <strong><%= t('contracts.submittedAt') %></strong><br />
          <%= new Date(orderForm.recordCreate_timeMillis).toLocaleString() %>
        </p>
      </div>
    </div>
    <div class="columns">
      <div class="column">
        <p>
          <strong class="<%= mismatchSet.has('Contract Type') ? 'has-text-danger' : '' %>"><%= t('contracts.contractType') %></strong><br />
          <%= orderFormData.contractTypeIdText || t('contracts.noValue') %>
        </p>
      </div>
      <div class="column">
        <p>
          <strong class="<%= mismatchSet.has('Cemetery') ? 'has-text-danger' : '' %>"><%= t('cemetery') %></strong><br />
          <%= orderFormData.cemeteryIdText || t('contracts.noCemetery') %>
        </p>
      </div>
      <div class="column">
        <p>
          <strong><%= t('cemeteries.burialSite') %></strong><br />
          <%= orderFormData.burialSiteName || t('contracts.noBurialSite') %>
        </p>
      </div>
    </div>
    <p class="mb-4">
      <strong><%= t('admin:serviceTypes') %></strong><br />
      <% if (selectedServiceTypeNames.length > 0) { %>
      <% for (const serviceTypeName of selectedServiceTypeNames) { %>
      <span class="tag is-light mr-2 mb-2"><%= serviceTypeName %></span>
      <% } %>
      <% } else { %>
      <span class="has-text-grey">(<%= t('contracts.noValue') %>)</span>
      <% } %>
    </p>
  </div>
</div>

<div class="panel">
  <div class="panel-heading">
    <%= t('contracts.services') %>
  </div>
  <div class="panel-block is-block">
    <div class="columns">
      <div class="column">
        <p>
          <strong class="<%= mismatchSet.has('Funeral Home') ? 'has-text-danger' : '' %>"><%= t('contracts.funeralHome') %></strong><br />
          <%= orderFormData.funeralHomeIdText || t('contracts.noFuneralHome') %>

          <% if (orderFormData.funeralHomeAddress1) { %>
          <br />
          <%= orderFormData.funeralHomeAddress1 %><br />
          <%= orderFormData.funeralHomeAddress2 %><br />
          <%= orderFormData.funeralHomeCity %>, <%= orderFormData.funeralHomeProvince %>
          <%= orderFormData.funeralHomePostalCode %>
          <% } %>
        </p>
      </div>
      <div class="column">
        <strong><%= t('contracts.funeralDirector') %></strong><br />
        <%= orderFormData.funeralDirectorName || t('contracts.noValue') %>
      </div>
    </div>
    <div class="columns">
      <div class="column">
        <strong><%= t('contracts.serviceDate') %></strong><br />
        <%= orderFormData.funeralDateString || t('contracts.noValue') %>
        <%= orderFormData.funeralTimeString %>
      </div>
      <div class="column">
        <p>
          <strong><%= t('directionOfArrival') %></strong><br />
          <%= orderFormData.directionOfArrival === '' ? t('contracts.noValue') : orderFormData.directionOfArrivalText %>
        </p>
      </div>
      <div class="column">
        <p>
          <strong class="<%= mismatchSet.has('Committal Type') ? 'has-text-danger' : '' %>"><%= t('contracts.committalType') %></strong><br />
          <%= orderFormData.committalTypeIdText || t('contracts.noCommittalType') %>
        </p>
      </div>
    </div>
  </div>
</div>

<div class="columns">
  <div class="column">
    <div class="panel">
      <div class="panel-heading">
        <%= t('contracts.purchaser') %>
      </div>
      <div class="panel-block is-block">
        <p class="mb-4">
          <strong><%= t('contracts.purchaserName') %></strong><br />
          <%= orderFormData.purchaserName || t('contracts.noPurchaser') %>
        </p>
        <p class="mb-4">
          <strong><%= t('address') %></strong><br />
          <%= orderFormData.purchaserAddress1 || t('contracts.noValue') %><br />
          <%= orderFormData.purchaserAddress2 %><br />
          <%= orderFormData.purchaserCity || t('contracts.noValue') %>, <%= orderFormData.purchaserProvince || t('contracts.noValue') %>
          <%= orderFormData.purchaserPostalCode || t('contracts.noValue') %>
        </p>
        <p class="mb-4">
          <strong><%= t('phoneNumber') %></strong><br />
          <%= orderFormData.purchaserPhoneNumber || t('contracts.noValue') %>
        </p>
        <p class="mb-4">
          <strong><%= t('contracts.relationshipToRecipient') %></strong><br />
          <%= orderFormData.purchaserRelationship || t('contracts.noValue') %>
        </p>
        <p>
          <strong><%= t('emailAddress') %></strong><br />
          <%= orderFormData.purchaserEmail || t('contracts.noValue') %>
        </p>
      </div>
    </div>
  </div>
  <div class="column">
    <div class="panel">
      <div class="panel-heading">
        <%= t('contracts.recipient') %>
      </div>
      <div class="panel-block is-block">
        <% if (orderFormData.deceasedSameAsPurchaser === 'true') { %>
        <p>
          <strong><%= t('contracts.deceasedSameAsPurchaser') %></strong>
        </p>
        <% } else { %>
        <p class="mb-4">
          <strong><%= t('contracts.deceasedName') %></strong><br />
          <%= orderFormData.deceasedName || t('contracts.noName') %>
        </p>
        <p class="mb-4">
          <strong><%= t('address') %></strong><br />
          <%= orderFormData.deceasedAddress1 || t('contracts.noValue') %><br />
          <%= orderFormData.deceasedAddress2 %><br />
          <%= orderFormData.deceasedCity || t('contracts.noValue') %>, <%= orderFormData.deceasedProvince || t('contracts.noValue') %>
          <%= orderFormData.deceasedPostalCode || t('contracts.noValue') %>
        </p>
        <% } %>
        <p class="mb-4">
          <strong><%= t('contracts.birthDate') %></strong><br />
          <%= orderFormData.birthDateString || t('contracts.noBirthDate') %>
        </p>
        <p class="mb-4">
          <strong><%= t('contracts.birthPlace') %></strong><br />
          <%= orderFormData.birthPlace || t('contracts.noValue') %>
        </p>
        <p class="mb-4">
          <strong><%= t('contracts.deathDate') %></strong><br />
          <%= orderFormData.deathDateString || t('contracts.noDeathDate') %>
        </p>
        <p class="mb-4">
          <strong><%= t('contracts.deathPlace') %></strong><br />
          <%= orderFormData.deathPlace || t('contracts.noValue') %>
        </p>
        <div class="columns">
          <div class="column">
            <p>
              <strong class="<%= mismatchSet.has('Container Type') ? 'has-text-danger' : '' %>"><%= t('admin:intermentContainerType') %></strong><br />
              <%= orderFormData.intermentContainerTypeIdText || t('contracts.noContainer') %>
            </p>
          </div>
          <div class="column">
            <p>
              <strong class="<%= mismatchSet.has('Depth') ? 'has-text-danger' : '' %>"><%= t('admin:intermentDepth') %></strong><br />
              <%= orderFormData.intermentDepthIdText || t('contracts.noDepth') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (orderFormData.comment) { %>
<div class="panel">
  <div class="panel-heading">
    <%= t('comments') %>
  </div>
  <div class="panel-block is-block">
    <p>
      <%= orderFormData.comment %>
    </p>
  </div>
</div>
<% } %>
