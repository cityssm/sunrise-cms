<div class="modal is-active" id="modal--orderForm" role="dialog">
  <div class="modal-background"></div>
  <div class="modal-card" style="width: min(1200px, 96vw); max-height: 95vh;">
    <header class="modal-card-head">
      <p class="modal-card-title">
        <%= t('contracts.orderFormTitle', { id: orderForm.orderFormId }) %>
      </p>
      <button class="delete" type="button" aria-label="<%= t('close') %>"></button>
    </header>
    <section class="modal-card-body">
      <input id="orderForm--orderFormId" type="hidden" value="<%= orderForm.orderFormId %>" />
      <%- include('_orderFormDetails', { orderForm, mismatches }); -%>
    </section>
    <footer class="modal-card-foot is-justify-content-space-between">
      <div></div>
      <div class="buttons is-right">
        <% if (showActions) { %>
        <% if (configFunctions.getConfigProperty('settings.auditLog.enabled')) { %>
        <div class="dropdown is-right is-up">
          <div class="dropdown-trigger">
            <button class="button is-light" type="button" title="<%= t('moreOptions') %>" aria-haspopup="true">
              <span class="icon is-small"><i class="fa-solid fa-angle-up"></i></span>
            </button>
          </div>
          <div class="dropdown-menu">
            <div class="dropdown-content has-text-left">
              <a
                class="dropdown-item is-view-audit-log-button"
                data-main-record-type="orderForm"
                data-main-record-id="<%= orderForm.orderFormId %>"
                data-record-create-user="<%= orderForm.recordCreate_username %>"
                data-record-create-millis="<%= orderForm.recordCreate_timeMillis %>"
                data-record-update-user="<%= orderForm.recordUpdate_username %>"
                data-record-update-millis="<%= orderForm.recordUpdate_timeMillis %>"
                data-audit-log-url="<%= urlPrefix %>/contracts/orderForms/<%= orderForm.orderFormId %>/doGetRecordAuditLog"
                href="#"
              >
                <span class="icon is-small"><i class="fa-solid fa-clock-rotate-left"></i></span>
                <span><%= t('auditLog') %></span>
              </a>
            </div>
          </div>
        </div>
        <% } %>
        <% if (canUpdateContracts) { %>
        <% if (orderForm.isOrderFormProcessed === 0) { %>
        <button class="button is-primary" id="button--processOrderForm" type="button">
          <span class="icon"><i class="fa-solid fa-file-circle-check"></i></span>
          <span><%= t('contracts.orderFormsProcess') %></span>
        </button>
        <% } %>
        <button class="button is-danger is-light" id="button--deleteOrderForm" type="button">
          <span class="icon"><i class="fa-solid fa-trash"></i></span>
          <span><%= t('contracts.orderFormsDelete') %></span>
        </button>
        <% } %>
        <% } %>
        <button class="button" id="button--closeOrderFormModal" type="button">
          <%= t('close') %>
        </button>
      </div>
    </footer>
  </div>
</div>
