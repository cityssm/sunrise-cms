<%- include('../_header'); -%>

<div class="columns is-mobile">
  <div class="column is-narrow is-hidden-print">
    <%- include('_menu'); -%>
  </div>
  <div class="column">
    <nav class="breadcrumb">
      <ul>
        <li><a href="<%= urlPrefix %>/dashboard"><%= t('home') %></a></li>
        <li class="is-active">
          <a href="#" aria-current="page">
            <span class="icon is-small">
              <i class="fa-solid fa-file-contract"></i>
            </span>
            <span><%= t('contracts') %></span>
          </a>
        </li>
      </ul>
    </nav>

    <% if (error !== undefined) { %>
    <div class="notification is-danger is-light">
      <button class="delete" type="button" aria-label="delete"></button>
      <p>
        <strong><%= t('contracts.contractError') %></strong><br />
        <%= error %>
      </p>
    </div>
    <% } %>

    <form id="form--searchFilters">
      <input
        id="searchFilter--offset"
        name="offset"
        type="hidden"
        value="0"
      />

      <div class="columns is-vcentered is-mobile">
        <div class="column">
          <h1 class="title is-1">
            <%= t('contracts.findAContract') %>
          </h1>
        </div>
        <div class="column has-text-right is-narrow">
          <div class="field has-addons">
            <div class="control">
              <label class="button is-small is-static has-text-grey-dark" for="searchFilter--limit"><%= t('results') %></label>
            </div>
            <div class="control">
              <div class="select is-small is-fullwidth">
                <select id="searchFilter--limit" name="limit" aria-label="Results per page">
                  <option value="50" selected>50</option>
                  <option value="100">100</option>
                  <option value="250">250</option>
                  <option value="500">500</option>
                </select>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="panel">
        <div class="panel-block is-block">
          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--contractTypeId"><%= t('contracts.contractType') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--contractTypeId" name="contractTypeId">
                      <option value=""><%= t('contracts.allContractTypes') %></option>

                      <%
                        let preneedHtml = ''
                        let atNeedHtml = ''

                        for (const contractType of contractTypes) {
                          if (contractType.isPreneed) {
                            preneedHtml += `
                              <option value="${contractType.contractTypeId}">
                                ${contractType.contractType}
                              </option>
                            `
                          } else {
                            atNeedHtml += `
                              <option value="${contractType.contractTypeId}">
                                ${contractType.contractType}
                              </option>
                            `
                          }
                        }
                      %>

                      <% if (preneedHtml !== '') { %>
                      <optgroup label="<%= t('contracts.preneedContractTypes') %>">
                        <%- preneedHtml %>
                      </optgroup>
                      <% } %>

                      <% if (atNeedHtml !== '') { %>
                      <optgroup label="<%= t('contracts.atNeedContractTypes') %>">
                        <%- atNeedHtml %>
                      </optgroup>
                      <% } %>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--contractNumber"><%= t('contracts.contractNumber') %></label>
                <div class="control has-icons-left">
                  <input
                    class="input"
                    id="searchFilter--contractNumber"
                    name="contractNumber"
                    type="text"
                    value="<%= contractNumber %>"
                  />
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <% if (configFunctions.getConfigProperty('settings.contracts.contractEndDateIsAvailable')) { %>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--contractTime"><%= t('contracts.contractTime') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--contractTime" name="contractTime">
                      <option value=""><%= t('contracts.allTimes') %></option>
                      <option value="current" selected><%= t('contracts.current') %></option>
                      <option value="past"><%= t('contracts.past') %></option>
                      <option value="future"><%= t('contracts.future') %></option>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <% } %>
          </div>
          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--serviceTypeId"><%= t('contracts.serviceType') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--serviceTypeId" name="serviceTypeId">
                      <option value=""><%= t('contracts.allServiceTypes') %></option>
                      <% for (const serviceType of serviceTypes) { %>
                      <option value="<%= serviceType.serviceTypeId %>">
                        <%= serviceType.serviceType %>
                      </option>
                      <% } %>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--deceasedName"><%= t('contracts.recipientOrDeceasedName') %></label>
                <div class="control has-icons-left">
                  <input
                    class="input"
                    id="searchFilter--deceasedName"
                    name="deceasedName"
                    type="text"
                    value="<%= deceasedName %>"
                  />
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% const hideLocationFilters = (cemeteryId ?? '') === '' %>
        <a
          class="panel-block has-background-light filter-block-toggle"
          data-cy="location-filters-toggle"
          href="#"
        >
          <span class="panel-icon">
            <i class="fa-solid fa-caret-right <%= hideLocationFilters ? '' : 'fa-rotate-90' %>"></i>
          </span>
          <%= t('contracts.locationFilters') %>
        </a>
        <div class="panel-block is-block <%= hideLocationFilters ? 'is-hidden' : '' %> animate__animated animate__fadeIn animate__faster">
          <div class="field">
            <label class="label" for="searchFilter--cemeteryId"><%= t('cemetery') %></label>
            <div class="control has-icons-left">
              <div class="select is-fullwidth">
                <select id="searchFilter--cemeteryId" name="cemeteryId">
                  <option value=""><%= t('contracts.allCemeteries') %></option>
                  
                  <% for (const cemetery of cemeteries) { %>
                  <option
                    data-selected="<%= (cemetery.cemeteryId.toString() === cemeteryId) ? 'selected' : '' %>"
                    value="<%= cemetery.cemeteryId %>"
                  >
                    <%= cemetery.cemeteryName || ('(' + t('cemeteries.noName') + ')') %>
                  </option>
                  <% } %>
                </select>
              </div>
              <span class="icon is-small is-left">
                <i class="fa-solid fa-search"></i>
              </span>
            </div>
          </div>
          <div class="columns">
            <div class="column">
              <label class="label" for="searchFilter--burialSiteName"><%= t('contracts.burialSite') %></label>
              <div class="field has-addons">
                <div class="control has-icons-left">
                  <div class="select">
                    <select id="selectFilter--burialSiteNameSearchType" name="burialSiteNameSearchType" aria-label="<%= t('contracts.burialSiteFilterType') %>">
                      <option value=""><%= t('contracts.contains') %></option>
                      <option value="startsWith"><%= t('contracts.startsWith') %></option>
                      <option value="endsWith"><%= t('contracts.endsWith') %></option>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
                <div class="control is-expanded">
                  <input
                    class="input"
                    id="searchFilter--burialSiteName"
                    name="burialSiteName"
                    type="text"
                  />
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--burialSiteTypeId"><%= t('contracts.burialSiteType') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--burialSiteTypeId" name="burialSiteTypeId">
                      <option value=""><%= t('contracts.allBurialSiteTypes') %></option>
                      <% for (const burialSiteType of burialSiteTypes) { %>
                      <option value="<%= burialSiteType.burialSiteTypeId %>"><%= burialSiteType.burialSiteType %></option>
                      <% } %>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a class="panel-block has-background-light filter-block-toggle" data-cy="contact-filters-toggle" href="#">
          <span class="panel-icon">
            <i class="fa-solid fa-caret-right"></i>
          </span>
          <%= t('contracts.contactFilters') %>
        </a>
        <div class="panel-block is-block is-hidden animate__animated animate__fadeIn animate__faster">
          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--purchaserName"><%= t('contracts.purchaserName') %></label>
                <div class="control has-icons-left">
                  <input
                    class="input"
                    id="searchFilter--purchaserName"
                    name="purchaserName"
                    type="text"
                  />
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--funeralHomeId"><%= t('contracts.funeralHome') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--funeralHomeId" name="funeralHomeId">
                      <option value=""><%= t('contracts.allFuneralHomes') %></option>
                      <% for (const funeralHome of funeralHomes) { %>
                      <option value="<%= funeralHome.funeralHomeId %>">
                        <%= funeralHome.funeralHomeName %>
                      </option>
                      <% } %>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a
          class="panel-block has-background-light filter-block-toggle"
          data-cy="fee-filters-toggle"
          href="#"
        >
          <span class="panel-icon">
            <i class="fa-solid fa-caret-right"></i>
          </span>
          <%= t('contracts.feeFilters') %>
        </a>
        <div class="panel-block is-block is-hidden animate__animated animate__fadeIn animate__faster">
          <div class="field">
            <label class="label" for="searchFilter--feeId"><%= t('contracts.feeType') %></label>
            <div class="control has-icons-left">
              <div class="select is-fullwidth">
                <select id="searchFilter--feeId" name="feeId">
                  <option value=""><%= t('contracts.allFeeTypes') %></option>
                  <% for (const feeCategory of feeCategories) { %>
                  <% if ((feeCategory.fees?.length ?? 0) > 0) { %>
                  <optgroup label="<%= feeCategory.feeCategory %>">
                    <% for (const fee of feeCategory.fees ?? []) { %>
                    <option value="<%= fee.feeId %>"><%= fee.feeName %></option>
                    <% } %>
                  </optgroup>
                  <% } %>
                  <% } %>
                </select>
              </div>
              <span class="icon is-small is-left">
                <i class="fa-solid fa-search"></i>
              </span>
            </div>
          </div>
          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--fees"><%= t('contracts.feesFilter') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--fees" name="fees">
                      <option value=""><%= t('contracts.unfiltered') %></option>
                      <option value="hasFees"><%= t('contracts.hasFees') %></option>
                      <option value="noFees"><%= t('contracts.noFees') %></option>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label" for="searchFilter--transactions"><%= t('contracts.transactions') %></label>
                <div class="control has-icons-left">
                  <div class="select is-fullwidth">
                    <select id="searchFilter--transactions" name="transactions">
                      <option value=""><%= t('contracts.unfiltered') %></option>
                      <option value="hasTransactions"><%= t('contracts.hasTransactions') %></option>
                      <option value="noTransactions"><%= t('contracts.noTransactions') %></option>
                      <option value="hasOutstandingBalance"><%= t('contracts.hasOutstandingBalance') %></option>
                    </select>
                  </div>
                  <span class="icon is-small is-left">
                    <i class="fa-solid fa-search"></i>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>

    <div class="mt-5" id="container--searchResults"></div>
  </div>
</div>

<%- include('../_footerA'); -%>

<script>
  exports.contractEndDateIsAvailable = <%= configFunctions.getConfigProperty('settings.contracts.contractEndDateIsAvailable') %>;
</script>

<script src="<%= urlPrefix %>/javascripts/contract.search.js"></script>
<script src="<%= urlPrefix %>/javascripts/search.js"></script>

<%- include('../_footerB'); -%>
