<div class="panel">
  <div class="panel-heading">
    <div class="columns is-vcentered is-mobile">
      <div class="column is-narrow">
        <button
          class="button is-small is-toggle-button"
          type="button"
          title="Toggle Interment Depths"
        >
          <span class="icon">
            <i class="fa-solid fa-plus"></i>
          </span>
        </button>
      </div>
      <div class="column">
        <h2 class="title is-5 has-text-white">
          Interment Depths
          <span class="tag ml-2" id="tag--intermentDepths">
            <%= intermentDepths.length %>
          </span>
        </h2>
      </div>
      <div class="column is-narrow">
        <i class="fa-solid fa-file-contract"></i>
      </div>
    </div>
  </div>
  <div class="panel-block is-block is-hidden">
    <table class="table is-fullwidth is-striped is-hoverable has-sticky-header">
      <thead>
        <tr>
          <th>Interment Depth</th>
          <% if (configFunctions.getConfigProperty('integrations.portal.integrationIsEnabled')) { %>
          <th>Sync with Portal</th>
          <% } %>
          <th class="has-text-centered has-width-1">Options</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <form id="form--addIntermentDepth">
              <div class="field">
                <div class="control">
                  <input
                    class="input"
                    name="intermentDepth"
                    type="text"
                    maxlength="100"
                    placeholder="New Interment Depth"
                    required
                  />
                </div>
              </div>
            </form>
          </td>
          <% if (configFunctions.getConfigProperty('integrations.portal.integrationIsEnabled')) { %>
          <td>
            <div class="control">
              <div class="select is-fullwidth">
                <select name="isAvailableOnPortal" aria-label="Sync with Portal" form="form--addIntermentDepth">
                  <option value="0">No</option>
                  <option value="1">Yes, Sync</option>
                </select>
              </div>
            </div>
          </td>
          <% } %>
          <td>
            <button
              class="button is-success"
              type="submit"
              title="Add Interment Depth"
              form="form--addIntermentDepth"
            >
              <span class="icon"><i class="fa-solid fa-plus"></i></span>
            </button>
          </td>
        </tr>
      </tbody>
      <tbody id="container--intermentDepths"></tbody>
    </table>
  </div>
</div>
