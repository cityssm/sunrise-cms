<%- include('../_header'); -%>

<div class="columns is-mobile">
  <div class="column is-narrow is-hidden-print">
    <%- include('_menu'); -%>
  </div>
  <div class="column">
    <div class="columns is-vcentered is-mobile">
      <div class="column">
        <nav class="breadcrumb">
          <ul>
            <li><a href="<%= urlPrefix %>/dashboard"><%= t('home') %></a></li>
            <li>
              <a href="#">
                <span class="icon is-small"><i class="fa-solid fa-cog"></i></span>
                <span><%= t('admin:adminTools') %></span>
              </a>
            </li>
            <li class="is-active">
              <a href="#" aria-current="page">
                <%= t('admin:userManagement') %>
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="column is-narrow has-text-right">
        <a
          class="has-text-info-dark is-size-7"
          href="https://cityssm.github.io/sunrise-cms/docs/userManagement.html"
          title="Help Documentation"
          rel="help noopener noreferrer"
          target="_blank"
        >
          <span class="icon is-small"><i class="fa-regular fa-circle-question"></i></span>
          <span><%= t('help') %></span>
        </a>
      </div>
    </div>

    <div class="columns is-vcentered">
      <div class="column">
        <h1 class="title is-1">
          <%= t('admin:userManagement') %>
        </h1>
      </div>
      <div class="column is-narrow">
        <button class="button is-success" id="button--addUser" type="button">
          <span class="icon">
            <i class="fa-solid fa-plus"></i>
          </span>
          <span><%= t('admin:addUser') %></span>
        </button>
      </div>
    </div>

    <% if (hasConfigUsers) { %>
    <div class="tabs is-boxed" role="tablist">
      <ul role="presentation">
        <li class="is-active" role="presentation">
          <a href="#tab--users">
            <i class="fa-solid fa-users"></i>
            <span class="ml-2"><%= t('admin:users') %></span>
          </a>
        </li>
        <li role="presentation">
          <a href="#tab--configUsers">
            <i class="fa-solid fa-file-lines"></i>
            <span class="ml-2"><%= t('admin:usersDefinedInConfig') %></span>
          </a>
        </li>
      </ul>
    </div>
    <% } %>
    <div class="tab-container">
      <div id="tab--users">
        <div id="container--users" data-users="<%= JSON.stringify(users) %>" data-domain="<%= domain %>"></div>
      </div>
      <% if (hasConfigUsers) { %>
      <div class="is-hidden" id="tab--configUsers">
        <table class="table is-fullwidth is-striped is-hoverable">
          <thead>
            <tr>
              <th><%= t('admin:username') %></th>
              <th class="has-text-centered"><%= t('admin:canLogin') %></th>
              <th class="has-text-centered"><%= t('admin:canUpdateCemeteries') %></th>
              <th class="has-text-centered"><%= t('admin:canUpdateContracts') %></th>
              <th class="has-text-centered"><%= t('admin:canUpdateWorkOrders') %></th>
              <th class="has-text-centered"><%= t('admin:isAdmin') %></th>
            </tr>
          </thead>
          <tbody>
            <% const configUserNames = [...new Set([
            ...(configUsers.canLogin ?? []),
            ...(configUsers.canUpdate ?? []),
            ...(configUsers.canUpdateCemeteries ?? []),
            ...(configUsers.canUpdateContracts ?? []),
            ...(configUsers.canUpdateWorkOrders ?? []),
            ...(configUsers.isAdmin ?? [])
            ].map((username) => username.toLowerCase()))].sort((left, right) => left.localeCompare(right)); %>
            <% for (const username of configUserNames) { %>
            <% const canLogin = (configUsers.canLogin ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <% const canUpdate = (configUsers.canUpdate ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <% const canUpdateCemeteries = canUpdate || (configUsers.canUpdateCemeteries ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <% const canUpdateContracts = canUpdate || (configUsers.canUpdateContracts ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <% const canUpdateWorkOrders = canUpdate || (configUsers.canUpdateWorkOrders ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <% const isAdmin = (configUsers.isAdmin ?? []).some((currentUsername) => currentUsername.toLowerCase() === username.toLowerCase()); %>
            <tr>
              <th class="is-vcentered"><%= username %></th>
              <td class="has-text-centered">
                <span class="tag <%= canLogin ? 'is-success' : 'is-light' %>"><%= canLogin ? t('yes') : t('no') %></span>
              </td>
              <td class="has-text-centered">
                <span class="tag <%= canUpdateCemeteries ? 'is-success' : 'is-light' %>"><%= canUpdateCemeteries ? t('yes') : t('no') %></span>
              </td>
              <td class="has-text-centered">
                <span class="tag <%= canUpdateContracts ? 'is-success' : 'is-light' %>"><%= canUpdateContracts ? t('yes') : t('no') %></span>
              </td>
              <td class="has-text-centered">
                <span class="tag <%= canUpdateWorkOrders ? 'is-success' : 'is-light' %>"><%= canUpdateWorkOrders ? t('yes') : t('no') %></span>
              </td>
              <td class="has-text-centered">
                <span class="tag <%= isAdmin ? 'is-success' : 'is-light' %>"><%= isAdmin ? t('yes') : t('no') %></span>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../_footerA'); -%>

<script src="<%= urlPrefix %>/javascripts/users.admin.js"></script>

<%- include('../_footerB'); -%>